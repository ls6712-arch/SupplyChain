# --- Supabase project (already filled in) ---
NEXT_PUBLIC_SUPABASE_URL=https://fayqjladqpexinykkuig.supabase.co

# From: Project Settings -> API -> Project API keys -> "anon" / "public"
# Safe to expose to the browser. NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From: Project Settings -> API -> Project API keys -> "service_role"
# SERVER-SIDE ONLY. Never expose this to the browser or commit it.
# Used only in trusted server actions (e.g. audit writes bypassing RLS if ever needed).
SUPABASE_SERVICE_ROLE_KEY=

# From: Project Settings -> Database -> Connection string -> "URI" (use the
# "Transaction" pooler string on port 6543 for serverless/Vercel; use the
# direct 5432 connection if running drizzle-kit migrations from your machine).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fayqjladqpexinykkuig.supabase.co:5432/postgres
